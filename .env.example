NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_SUPABASE_URL=https://cotizapp.lat
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role de Supabase (proyecto cotizapp-ia → Settings → API). Saltea RLS:
# solo la usa código server-only (lib/supabase/service-role.ts y el script de
# migración fiscal). En Vercel va marcada SOLO para el entorno Production.
SUPABASE_SERVICE_ROLE_KEY=
# Clave maestra del cifrado de material fiscal (clave privada de ARCA). Base64
# de 32 bytes exactos: generala con `openssl rand -base64 32`. En Vercel va
# marcada SOLO para el entorno Production — si estuviera en Preview, cualquier
# deploy de un PR podría descifrar el material de producción.
# Si se pierde, las claves privadas de todos los usuarios quedan
# irrecuperables: respaldala fuera de Vercel (gestor de contraseñas) antes de
# usarla para nada.
FISCAL_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
NEXT_PUBLIC_APP_URL=https://cotizapp.lat
